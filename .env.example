# 复制本文件为 .env 后填写。.env 已被 .gitignore 排除，绝不提交。
# 改这里就能换模型供应商，代码不需要动。

# ---------- 模型服务（OpenAI 兼容协议） ----------
# 阿里云百炼（qwen-flash + text-embedding-v3）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
# DeepSeek 不提供 embedding，向量化单独配置百炼
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
AI_CHAT_MODEL=deepseek-chat
AI_EMBEDDING_MODEL=text-embedding-v3

# 若改用 DeepSeek 生成（注意 embedding 仍需留在百炼，或用本地模型）
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_CHAT_MODEL=deepseek-chat

AI_TIMEOUT=30
AI_MAX_RETRIES=2

# ---------- 切块与检索 ----------
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
# 阈值必须靠 probe_retrieval.py 实测标定，不要凭感觉写；
# 目标：落在「无关问题最高分」与「相关问题最低 top-1」之间
RAG_SCORE_THRESHOLD=0.62
EMBEDDING_BATCH_SIZE=10

# ---------- Chroma ----------
CHROMA_COLLECTION=news_chunks

# ---------- 原有基础设施 ----------
DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/news_app?charset=utf8mb4
DATABASE_ECHO=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=2
